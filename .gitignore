# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Commercial fonts stay out of git. Degular Display has a desktop licence only (never upload it); Circular Std
# (Lineto) ships with the site under Muskan's web licence but is deployed from the working tree, not committed.
/public/fonts/Degular*
/public/fonts/CircularStd*

# Mockup renders and contact sheets (regenerated by the scripts in tools/mockups)
/tools/mockups/out/

# Local agent tooling (not part of the site)
/.agents/
/.claude/
/.impeccable/
skills-lock.json

# Ngetic Modern (Nirmana Visual) is licensed for personal use only: local preview, never pushed or deployed
public/fonts/ngetic/
